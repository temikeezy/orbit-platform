{
  "name": "orbit-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for ORBIT — exposes users, streams, tasks, submissions, leaderboard, feed, messaging and settings to AI agents through the ORBIT Convex deployment",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "convex": "^1.43.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only"
}
