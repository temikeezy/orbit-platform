{
  "name": "orbit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.convex.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "capture": "ORBIT_CAPTURE=1 playwright test --project=capture",
    "capture:all": "ORBIT_CAPTURE=1 ORBIT_CAPTURE_ROLES=intern,moderator,admin,super_admin playwright test --project=capture",
    "capture:gallery": "tsx e2e/capture/gallery.ts",
    "capture:manual": "ORBIT_CAPTURE=1 ORBIT_MANUAL_SHOTS=1 playwright test --project=capture --grep 'manual shots'",
    "manual:optimise": "tsx e2e/capture/optimise-manual-img.ts",
    "manual:build": "python3 docs/manual/build.py",
    "convex": "env -u CONVEX_DEPLOY_KEY convex",
    "convex:push": "env -u CONVEX_DEPLOY_KEY convex dev --once",
    "convex:deploy": "env -u CONVEX_DEPLOY_KEY convex deploy -y",
    "convex:export": "env -u CONVEX_DEPLOY_KEY convex export --include-file-storage",
    "manual:publish": "python3 docs/manual/publish.py"
  },
  "dependencies": {
    "@sentry/react": "^10.40.0",
    "bcryptjs": "^3.0.3",
    "convex": "^1.43.0",
    "lucide-react": "^0.344.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "license": "AGPL-3.0-only"
}
