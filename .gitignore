# TypeScript incremental build info
*.tsbuildinfo

# convex/_generated is deliberately COMMITTED, not ignored: a fresh clone can then
# typecheck and build without running codegen first. (The old reason given here --
# that this machine's Convex CLI could not authenticate non-interactively -- was a
# stale CONVEX_DEPLOY_KEY in the shell profile and is resolved; see
# docs/CONVEX_MIGRATION.md. Codegen runs fine locally.)

# Playwright: fixture sessions contain live tokens
e2e/.auth/
test-results/
playwright-report/

# Playwright visual capture output — regenerate with `npm run capture`.
e2e/capture/output/
e2e/capture/output.full/
e2e/capture/gallery*.html
scripts/agent/__pycache__/

# Real names the manual-screenshot tripwire checks for (never commit)
e2e/capture/real-names.local.txt
